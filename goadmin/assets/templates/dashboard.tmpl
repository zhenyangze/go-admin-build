{{define "dashboard"}}
<div class="card-grid">
  {{range .Cards}}
  <article class="metric-card">
    <div class="metric-title">{{.Title}}</div>
    <div class="metric-value">{{.Value}}</div>
    <div class="text-sm text-slate-500">{{.Hint}}</div>
  </article>
  {{end}}
</div>
{{if .Panels}}
<div class="grid gap-6 lg:grid-cols-2 mt-6">
  {{range .Panels}}
  <section class="panel">
    <div class="panel-head">
      <div>
        <h2 class="panel-title">{{.Title}}</h2>
        {{if .Description}}<p class="panel-copy">{{.Description}}</p>{{end}}
      </div>
      {{if .Actions}}
      <div class="actions-row">
        {{range .Actions}}
        <a class="btn {{if eq .Class "btn-primary"}}btn-primary{{else}}btn-secondary{{end}}" href="{{.URL}}">
          {{.Label}}
        </a>
        {{end}}
      </div>
      {{end}}
    </div>
    {{if .Items}}
    <div class="panel-body">
      <div class="space-y-4">
        {{range .Items}}
        <div class="flex items-start justify-between gap-4 py-3 border-b border-slate-100 last:border-0 last:pb-0 first:pt-0">
          <div class="flex-1 min-w-0">
            {{if .URL}}
            <a href="{{.URL}}" class="text-sm font-medium text-slate-900 hover:text-primary-600 transition-colors">{{.Title}}</a>
            {{else}}
            <div class="text-sm font-medium text-slate-900">{{.Title}}</div>
            {{end}}
            {{if .Description}}<div class="text-sm text-slate-500 mt-0.5">{{.Description}}</div>{{end}}
            {{if .Tags}}
            <div class="flex flex-wrap gap-2 mt-2">
              {{range .Tags}}<span class="badge badge-warning">{{.}}</span>{{end}}
            </div>
            {{end}}
          </div>
          {{if .Value}}<div class="text-sm font-medium text-slate-700 shrink-0">{{.Value}}</div>{{end}}
        </div>
        {{end}}
      </div>
    </div>
    {{else}}
    <div class="panel-body">
      <div class="empty empty-inline">
        <div class="empty-text">{{.EmptyText}}</div>
      </div>
    </div>
    {{end}}
  </section>
  {{end}}
</div>
{{end}}
{{end}}
