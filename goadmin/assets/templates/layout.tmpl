{{define "layout"}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{.PageTitle}} | {{.Title}}</title>
  <link rel="stylesheet" href="{{.Prefix}}/assets/admin.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
</head>
<body class="admin-shell">
  <div class="admin-frame">
    <aside class="admin-sidebar">
      <div class="admin-brand">
        <div class="admin-brand-mark">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2L2 7l10 5 10-5-10-5z"/>
            <path d="M2 17l10 5 10-5"/>
            <path d="M2 12l10 5 10-5"/>
          </svg>
        </div>
        <div>
          <div class="admin-brand-name">{{.AppName}}</div>
          <div class="admin-brand-sub">Admin Dashboard</div>
        </div>
      </div>
      <nav class="admin-nav">
        {{template "nav-items" .Menu}}
      </nav>
    </aside>
    <main class="admin-main">
      <header class="admin-topbar">
        <div>
          <h1 class="admin-page-title">{{.PageTitle}}</h1>
          {{if .PageDescription}}<p class="admin-page-desc">{{.PageDescription}}</p>{{end}}
        </div>
        <div class="admin-topbar-right">
          <span class="admin-user">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-400">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
            {{.User.DisplayName}}
          </span>
          <form method="post" action="{{.Prefix}}/logout">
            <input type="hidden" name="_csrf" value="{{.CSRF}}">
            <button class="btn btn-secondary btn-sm" type="submit">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" y1="12" x2="9" y2="12"/>
              </svg>
              Logout
            </button>
          </form>
        </div>
      </header>
      {{if .Flash}}
      <div class="admin-content">
        <div class="flash flash-info">{{.Flash}}</div>
      </div>
      {{end}}
      {{if .Helper}}
      <div class="admin-content">
        <section class="panel panel-helper">
          <div class="panel-head">
            <div>
              <div class="panel-title-sm">{{.Helper.Title}}</div>
            </div>
            {{if .Helper.Tags}}
            <div class="actions-row">
              {{range .Helper.Tags}}<span class="badge badge-warning">{{.}}</span>{{end}}
            </div>
            {{end}}
          </div>
          <div class="panel-body">
            <div class="detail-list">
              {{range .Helper.Items}}
              <div class="detail-row">
                <div class="text-slate-500 text-sm">{{.}}</div>
              </div>
              {{end}}
            </div>
          </div>
        </section>
      </div>
      {{end}}
      <section class="admin-content">
        {{safeHTML .ContentHTML}}
      </section>
    </main>
  </div>
</body>
</html>
{{end}}

{{define "nav-items"}}
{{range .}}
  <div class="nav-group">
    {{if .URL}}
      <a class="nav-link {{if .Active}}is-active{{end}}" href="{{.URL}}">
        <span class="nav-icon">
          {{if .Icon}}
            {{safeHTML .Icon}}
          {{else}}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"/>
              <path d="M12 1v6m0 6v10"/>
            </svg>
          {{end}}
        </span>
        <span>{{.Title}}</span>
      </a>
    {{else}}
      <div class="nav-label">{{.Title}}</div>
    {{end}}
    {{if .Children}}
      <div class="nav-children {{if .Expanded}}is-open{{end}}">
        {{template "nav-items" .Children}}
      </div>
    {{end}}
  </div>
{{end}}
{{end}}
