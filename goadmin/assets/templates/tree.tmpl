{{define "tree"}}
<div class="panel">
  <div class="panel-head">
    <div>
      <h2 class="panel-title">{{.Title}}</h2>
      {{if .Description}}<p class="panel-copy">{{.Description}}</p>{{end}}
    </div>
  </div>
  {{if .Nodes}}
  <div class="panel-body">
    <div class="tree-root">
      {{template "tree-nodes" .Nodes}}
    </div>
  </div>
  {{else}}
  <div class="panel-body">
    <div class="empty">
      <svg class="empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="3" y="3" width="18" height="18" rx="2"/>
        <path d="M3 9h18"/>
        <path d="M9 3v18"/>
      </svg>
      <div class="empty-title">No records found</div>
      <div class="empty-text">{{.EmptyText}}</div>
    </div>
  </div>
  {{end}}
</div>
{{end}}

{{define "tree-nodes"}}
<ul class="tree-list">
  {{range .}}
  <li>
    <div class="flex items-start gap-3 py-2">
      <div class="flex-1">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2L2 7l10 5 10-5-10-5z"/>
            <path d="M2 17l10 5 10-5"/>
            <path d="M2 12l10 5 10-5"/>
          </svg>
          <span class="text-sm font-medium text-slate-900">{{.Title}}</span>
        </div>
        {{if .Description}}<div class="text-sm text-slate-500 mt-0.5 ml-6">{{.Description}}</div>{{end}}
      </div>
    </div>
    {{if .Children}}
    <div class="ml-6 pl-4 border-l border-slate-200 mt-1">
      {{template "tree-nodes" .Children}}
    </div>
    {{end}}
  </li>
  {{end}}
</ul>
{{end}}
