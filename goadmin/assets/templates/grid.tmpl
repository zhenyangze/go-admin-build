{{define "grid"}}
<div class="panel">
  <div class="panel-head">
    <div>
      <h2 class="panel-title">{{.Title}}</h2>
      <p class="panel-copy">{{.Description}}</p>
    </div>
    {{if .Actions}}
    <div class="actions-row">
      {{range .Actions}}
        {{if eq .Method "GET"}}
        <a class="{{.Class}}" href="{{.URL}}">{{.Label}}</a>
        {{else}}
        <form method="post" action="{{.URL}}" onsubmit="{{if .Confirm}}return confirm('{{.Confirm}}'){{else}}return true{{end}}">
          {{if ne .Method "POST"}}<input type="hidden" name="_method" value="{{.Method}}">{{end}}
          <input type="hidden" name="_csrf" value="{{$.CSRF}}">
          <button class="{{.Class}}" type="submit">{{.Label}}</button>
        </form>
        {{end}}
      {{end}}
    </div>
    {{end}}
  </div>
  <form class="toolbar" method="get" action="{{.CurrentPath}}">
    <input class="toolbar-search" type="search" name="q" value="{{.QuickSearch}}" placeholder="Quick search">
    {{range .Filters}}
      {{if eq .Kind "select"}}
      <label class="toolbar-filter">
        <span>{{.Label}}</span>
        <select name="{{.InputKey}}">
          <option value="">All</option>
          {{range .Options}}
          <option value="{{.Value}}" {{if .Selected}}selected{{end}}>{{.Label}}</option>
          {{end}}
        </select>
      </label>
      {{else}}
      <label class="toolbar-filter">
        <span>{{.Label}}</span>
        <input type="text" name="{{.InputKey}}" value="{{.Value}}">
      </label>
      {{end}}
    {{end}}
    <button class="btn btn-ghost" type="submit">Apply</button>
  </form>
  <div class="table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          {{range .Columns}}
          <th>
            {{if .Sortable}}
            <a href="{{.SortURL}}">{{.Label}}</a>
            {{else}}
            {{.Label}}
            {{end}}
          </th>
          {{end}}
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {{if .Rows}}
        {{range .Rows}}
        <tr>
          {{range .Cells}}
          <td>{{safeHTML .}}</td>
          {{end}}
          <td class="actions">
            {{if .Actions}}
              {{range .Actions}}
                {{if eq .Method "GET"}}
                <a href="{{.URL}}">{{.Label}}</a>
                {{else}}
                <form method="post" action="{{.URL}}" onsubmit="{{if .Confirm}}return confirm('{{.Confirm}}'){{else}}return true{{end}}">
                  {{if ne .Method "POST"}}<input type="hidden" name="_method" value="{{.Method}}">{{end}}
                  <input type="hidden" name="_csrf" value="{{$.CSRF}}">
                  <button type="submit">{{.Label}}</button>
                </form>
                {{end}}
              {{end}}
            {{else}}
            <span class="muted">—</span>
            {{end}}
          </td>
        </tr>
        {{end}}
        {{else}}
        <tr>
          <td colspan="{{.ColSpan}}">
            <div class="empty empty-inline">{{.EmptyText}}</div>
          </td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>
  <div class="panel-foot">
    <span class="muted">{{.ResultSummary}}</span>
    <div class="pagination">
      {{range .Pagination}}
      <a class="page-link {{if .Current}}is-current{{end}}" href="{{.URL}}">{{.Label}}</a>
      {{end}}
    </div>
  </div>
</div>
{{end}}
