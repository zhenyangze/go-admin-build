{{define "grid"}}
<div class="panel">
  <div class="panel-head">
    <div>
      <h2 class="panel-title">{{.Title}}</h2>
      {{if .Description}}<p class="panel-copy">{{.Description}}</p>{{end}}
    </div>
    {{if .Actions}}
    <div class="actions-row">
      {{range .Actions}}
        {{if eq .Method "GET"}}
        <a class="{{.Class}}" href="{{.URL}}">
          {{if eq .Label "Create"}}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"/>
            <line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
          {{end}}
          {{.Label}}
        </a>
        {{else}}
        <form method="post" action="{{.URL}}" onsubmit="{{if .Confirm}}return confirm('{{.Confirm}}'){{else}}return true{{end}}">
          {{if ne .Method "POST"}}<input type="hidden" name="_method" value="{{.Method}}">{{end}}
          <input type="hidden" name="_csrf" value="{{$.CSRF}}">
          <button class="{{.Class}}" type="submit">
            {{if eq .Label "Export"}}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            {{end}}
            {{.Label}}
          </button>
        </form>
        {{end}}
      {{end}}
    </div>
    {{end}}
  </div>

  <form class="toolbar" method="get" action="{{.CurrentPath}}">
    <div class="flex items-center gap-3">
      <div class="relative">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
        <input class="toolbar-search pl-9" type="search" name="q" value="{{.QuickSearch}}" placeholder="Search...">
      </div>
    </div>
    {{if .Filters}}
    <div class="flex items-center gap-3 flex-wrap">
      {{range .Filters}}
        {{if eq .Kind "select"}}
        <div class="toolbar-filter">
          <select name="{{.InputKey}}">
            <option value="">{{.Label}}</option>
            {{range .Options}}
            <option value="{{.Value}}" {{if .Selected}}selected{{end}}>{{.Label}}</option>
            {{end}}
          </select>
        </div>
        {{else}}
        <div class="toolbar-filter">
          <input type="text" name="{{.InputKey}}" value="{{.Value}}" placeholder="{{.Label}}">
        </div>
        {{end}}
      {{end}}
      <button class="btn btn-secondary btn-sm" type="submit">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
        </svg>
        Apply
      </button>
    </div>
    {{end}}
  </form>

  <div class="table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          {{range .Columns}}
          <th>
            {{if .Sortable}}
            <a href="{{.SortURL}}" class="flex items-center gap-1">
              {{.Label}}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-slate-400">
                <path d="m7 15 5 5 5-5"/>
                <path d="m7 9 5-5 5 5"/>
              </svg>
            </a>
            {{else}}
            {{.Label}}
            {{end}}
          </th>
          {{end}}
          <th class="text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        {{if .Rows}}
        {{range .Rows}}
        <tr>
          {{range .Cells}}
          <td>{{safeHTML .}}</td>
          {{end}}
          <td class="actions text-right">
            {{if .Actions}}
              {{range .Actions}}
                {{if eq .Method "GET"}}
                <a href="{{.URL}}" class="inline-flex items-center gap-1">
                  {{if eq .Label "View"}}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
                    <circle cx="12" cy="12" r="3"/>
                  </svg>
                  {{else if eq .Label "Edit"}}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/>
                  </svg>
                  {{end}}
                  {{.Label}}
                </a>
                {{else}}
                <form method="post" action="{{.URL}}" onsubmit="{{if .Confirm}}return confirm('{{.Confirm}}'){{else}}return true{{end}}">
                  {{if ne .Method "POST"}}<input type="hidden" name="_method" value="{{.Method}}">{{end}}
                  <input type="hidden" name="_csrf" value="{{$.CSRF}}">
                  <button type="submit" class="inline-flex items-center gap-1">
                    {{if eq .Label "Delete"}}
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="3 6 5 6 21 6"/>
                      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                    </svg>
                    {{end}}
                    {{.Label}}
                  </button>
                </form>
                {{end}}
              {{end}}
            {{else}}
            <span class="text-slate-400">—</span>
            {{end}}
          </td>
        </tr>
        {{end}}
        {{else}}
        <tr>
          <td colspan="{{.ColSpan}}">
            <div class="empty">
              <svg class="empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <path d="M3 9h18"/>
              </svg>
              <div class="empty-title">No records found</div>
              <div class="empty-text">{{.EmptyText}}</div>
            </div>
          </td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>

  {{if .Rows}}
  <div class="panel-foot">
    <span class="text-slate-500 text-sm">{{.ResultSummary}}</span>
    <div class="pagination">
      {{range .Pagination}}
      <a class="page-link {{if .Current}}is-current{{end}} {{if .Disabled}}is-disabled{{end}}" href="{{.URL}}">{{.Label}}</a>
      {{end}}
    </div>
  </div>
  {{end}}
</div>
{{end}}
