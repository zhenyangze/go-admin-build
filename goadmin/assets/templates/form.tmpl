{{define "form"}}
<div class="panel">
  <div class="panel-head">
    <div>
      <h2 class="panel-title">{{.Title}}</h2>
      {{if .Description}}<p class="panel-copy">{{.Description}}</p>{{end}}
    </div>
    <a class="btn btn-secondary" href="{{.BackURL}}">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="m15 18-6-6 6-6"/>
      </svg>
      Back
    </a>
  </div>

  {{if .Message}}
  <div class="panel-body">
    <div class="flash flash-error">{{.Message}}</div>
  </div>
  {{end}}

  <form class="panel-body" method="post" action="{{.Action}}" enctype="{{.Enctype}}">
    {{if eq .Method "PUT"}}
    <input type="hidden" name="_method" value="PUT">
    {{end}}
    <input type="hidden" name="_csrf" value="{{.CSRF}}">

    <div class="stack">
      {{range .Fields}}
        {{if eq .Type "hidden"}}
        <input type="hidden" name="{{.Name}}" value="{{.Value}}">

        {{else if eq .Type "display"}}
        <div class="field">
          <span>{{.Label}}</span>
          <div class="display-field">{{.Value}}</div>
        </div>

        {{else if eq .Type "textarea"}}
        <label class="field">
          <span>{{.Label}}{{if .Required}}<span class="required">*</span>{{end}}</span>
          <textarea name="{{.Name}}" placeholder="{{.Placeholder}}" {{if .Error}}class="error"{{end}}>{{.Value}}</textarea>
          {{if .Error}}<small class="error-message">{{.Error}}</small>{{end}}
          {{if .Help}}<small>{{.Help}}</small>{{end}}
        </label>

        {{else if eq .Type "select"}}
        <label class="field">
          <span>{{.Label}}{{if .Required}}<span class="required">*</span>{{end}}</span>
          <select name="{{.Name}}" {{if .Error}}class="error"{{end}}>
            {{range .Options}}
            <option value="{{.Value}}" {{if .Selected}}selected{{end}}>{{.Label}}</option>
            {{end}}
          </select>
          {{if .Error}}<small class="error-message">{{.Error}}</small>{{end}}
          {{if .Help}}<small>{{.Help}}</small>{{end}}
        </label>

        {{else if eq .Type "multiselect"}}
        <label class="field">
          <span>{{.Label}}{{if .Required}}<span class="required">*</span>{{end}}</span>
          <select name="{{.Name}}" multiple size="{{if gt (len .Options) 6}}6{{else if gt (len .Options) 0}}{{len .Options}}{{else}}4{{end}}" {{if .Error}}class="error"{{end}}>
            {{range .Options}}
            <option value="{{.Value}}" {{if .Selected}}selected{{end}}>{{.Label}}</option>
            {{end}}
          </select>
          {{if .Error}}<small class="error-message">{{.Error}}</small>{{end}}
          {{if .Help}}<small>{{.Help}}</small>{{end}}
        </label>

        {{else if eq .Type "switch"}}
        <div class="field">
          <span>{{.Label}}{{if .Required}}<span class="required">*</span>{{end}}</span>
          <label class="inline-flex items-center gap-3 cursor-pointer">
            <div class="relative inline-flex h-6 w-11 items-center rounded-full bg-slate-200 transition-colors focus-within:ring-2 focus-within:ring-primary-500 focus-within:ring-offset-2 has-[:checked]:bg-primary-600">
              <input name="{{.Name}}" type="checkbox" value="1" {{if .Checked}}checked{{end}} class="peer sr-only">
              <span class="inline-block h-4 w-4 rounded-full bg-white transition-transform peer-checked:translate-x-6 translate-x-1"></span>
            </div>
            <span class="text-sm text-slate-600">{{if .Checked}}Enabled{{else}}Disabled{{end}}</span>
          </label>
          {{if .Error}}<small class="error-message">{{.Error}}</small>{{end}}
          {{if .Help}}<small>{{.Help}}</small>{{end}}
        </div>

        {{else if eq .Type "tags"}}
        <label class="field">
          <span>{{.Label}}{{if .Required}}<span class="required">*</span>{{end}}</span>
          <input name="{{.Name}}" type="text" value="{{.Value}}" placeholder="{{if .Placeholder}}{{.Placeholder}}{{else}}e.g. go, admin, tailwind{{end}}" {{if .Error}}class="error"{{end}}>
          {{if .Error}}<small class="error-message">{{.Error}}</small>{{end}}
          {{if .Help}}<small>{{.Help}}</small>{{end}}
        </label>

        {{else if eq .Type "daterange"}}
        <label class="field">
          <span>{{.Label}}{{if .Required}}<span class="required">*</span>{{end}}</span>
          <div class="grid gap-3 sm:grid-cols-2">
            <input name="{{.Name}}" type="date" value="{{.Value}}" placeholder="{{.Placeholder}}" {{if .Error}}class="error"{{end}}>
            <input name="{{.SecondName}}" type="date" value="{{.SecondValue}}" placeholder="{{.SecondPlaceholder}}" {{if .Error}}class="error"{{end}}>
          </div>
          {{if .Error}}<small class="error-message">{{.Error}}</small>{{end}}
          {{if .Help}}<small>{{.Help}}</small>{{end}}
        </label>

        {{else if eq .Type "repeater"}}
        <div class="field">
          <span>{{.Label}}{{if .Required}}<span class="required">*</span>{{end}}</span>
          {{$field := .}}
          <div class="space-y-3">
            {{range $field.RepeaterRows}}
            {{$row := .}}
            <div class="repeater-item">
              <div class="grid gap-3 sm:grid-cols-2">
                {{range $field.RepeaterFields}}
                  {{if eq .Type "hidden"}}
                  <input name="{{$field.Name}}.{{$row.Index}}.{{.Name}}" type="hidden" value="{{index $row.Values .Name}}">
                  {{else if eq .Type "textarea"}}
                  <textarea name="{{$field.Name}}.{{$row.Index}}.{{.Name}}" placeholder="{{.Placeholder}}" class="min-h-[80px]">{{index $row.Values .Name}}</textarea>
                  {{else}}
                  <input name="{{$field.Name}}.{{$row.Index}}.{{.Name}}" type="{{if .Type}}{{.Type}}{{else}}text{{end}}" value="{{index $row.Values .Name}}" placeholder="{{.Placeholder}}">
                  {{end}}
                {{end}}
              </div>
            </div>
            {{end}}
          </div>
          {{if .Error}}<small class="error-message">{{.Error}}</small>{{end}}
          {{if .Help}}<small>{{.Help}}</small>{{end}}
        </div>

        {{else if eq .Type "file"}}
        <label class="field">
          <span>{{.Label}}{{if .Required}}<span class="required">*</span>{{end}}</span>
          <div class="relative">
            <input name="{{.Name}}" type="file" {{if .Multiple}}multiple{{end}} {{if .Error}}class="error"{{end}} class="block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-primary-50 file:text-primary-700 hover:file:bg-primary-100">
          </div>
          {{if .FileURLs}}
            <div class="mt-3 space-y-2">
              {{range .FileURLs}}
              <a href="{{.}}" target="_blank" rel="noreferrer" class="text-sm text-primary-600 hover:text-primary-700 inline-flex items-center gap-2">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                  <polyline points="7 10 12 15 17 10"/>
                  <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
                {{.}}
              </a>
              {{end}}
            </div>
          {{else if .FileURL}}
            <div class="mt-3 file-preview">
              {{if .IsImage}}<img src="{{.FileURL}}" alt="{{.Label}}" class="mb-2">{{end}}
              <a href="{{.FileURL}}" target="_blank" rel="noreferrer" class="text-sm text-primary-600 hover:text-primary-700 inline-flex items-center gap-2">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                  <polyline points="7 10 12 15 17 10"/>
                  <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
                {{.FileURL}}
              </a>
            </div>
          {{end}}
          {{if .Error}}<small class="error-message">{{.Error}}</small>{{end}}
          {{if .Help}}<small>{{.Help}}</small>{{end}}
        </label>

        {{else}}
        <label class="field">
          <span>{{.Label}}{{if .Required}}<span class="required">*</span>{{end}}</span>
          <input name="{{.Name}}" type="{{.Type}}" value="{{.Value}}" placeholder="{{.Placeholder}}" {{if .Readonly}}readonly{{end}} {{if .Error}}class="error"{{end}}>
          {{if .Error}}<small class="error-message">{{.Error}}</small>{{end}}
          {{if .Help}}<small>{{.Help}}</small>{{end}}
        </label>
        {{end}}
      {{end}}

      <div class="flex items-center gap-3 pt-4 border-t border-slate-100">
        <button class="btn btn-primary" type="submit">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
            <polyline points="17 21 17 13 7 13 7 21"/>
            <polyline points="7 3 7 8 15 8"/>
          </svg>
          {{.SubmitLabel}}
        </button>
        <a class="btn btn-secondary" href="{{.BackURL}}">Cancel</a>
      </div>
    </div>
  </form>

  {{if .ShowDelete}}
  <div class="panel-body border-t border-slate-100">
    <form method="post" action="{{.DeleteAction}}" onsubmit="return confirm('Are you sure you want to delete this record? This action cannot be undone.')">
      <input type="hidden" name="_csrf" value="{{.CSRF}}">
      <button class="btn btn-danger" type="submit">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="3 6 5 6 21 6"/>
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
        </svg>
        {{.DeleteLabel}}
      </button>
    </form>
  </div>
  {{end}}
</div>
{{end}}
